# Copia este archivo a .env y completa las claves del proveedor que uses.
# El Asistente IA soporta dos proveedores; elige uno con VITE_AI_PROVIDER.

# Proveedor activo: "groq" (gratis, recomendado) o "gemini"
VITE_AI_PROVIDER=groq

# --- Groq (gratis, global) — clave en https://console.groq.com/keys ---
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# --- Gemini (requiere cuenta con tier gratuito) — clave en https://aistudio.google.com/app/apikey ---
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash

# Nota: en una app de frontend la clave queda visible en el bundle.
# Restringe la clave por dominio/uso en el panel del proveedor.
